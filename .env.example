DATABASE_URL=jdbc:postgresql://localhost:5432/carboncalculator
DATABASE_USERNAME=carboncalculator
DATABASE_PASSWORD=change-me
PORT=8080
JWT_SECRET=

# Google OAuth2 (optional — leave empty to disable)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Railway sets SPRING_PROFILES_ACTIVE=prod automatically via railway.toml
# In production, DATABASE_USERNAME/PASSWORD are also used as app datasource credentials
# (no separate 'app' role needed since Railway's user is not a superuser, so RLS is enforced)
